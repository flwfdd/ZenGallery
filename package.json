{
  "name": "zen-gallery",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "vue-tsc --noEmit && vitest run && eslint . && vite build --mode client && vite build",
    "preview": "vite build --mode client && vite build && wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && vite build --mode client && vite build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@hono/zod-validator": "^0.9.0",
    "@lucide/vue": "^1.34.0",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.5",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@eslint/js": "^10.0.1",
    "@hono/vite-build": "^1.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.126.0"
  },
  "packageManager": "pnpm@11.12.0"
}
