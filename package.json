{
  "name": "zen-gallery",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "vue-tsc --noEmit && vitest run && eslint . && vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && vite build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@hono/zod-validator": "^0.9.1",
    "@lucide/vue": "^1.74.0",
    "@noble/hashes": "^2.4.0",
    "hash-wasm": "^4.13.0",
    "hono": "^4.13.19",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.164.0"
  },
  "packageManager": "pnpm@12.21.0"
}
